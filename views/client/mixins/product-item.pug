mixin product-item(item)
  -
    const computedDiscount = typeof item.discount === 'number' && !Number.isNaN(item.discount)
      ? item.discount
      : (item.priceAdult > 0 && item.newPriceAdult > 0 && item.priceAdult > item.newPriceAdult
        ? Math.round(((item.priceAdult - item.newPriceAdult) / item.priceAdult) * 100)
        : 0);
  .product-item
    .inner-image
      a(href=`/tour/detail/${item.slug}`)
        img(
          alt=item.name
          src=item.avatar
          )
    if computedDiscount > 0
      .inner-discount
        i.fa-solid.fa-bolt
        | Giảm -#{computedDiscount}%
    .inner-content
      h3.inner-title
        a(href=`/tour/detail/${item.slug}`) #{item.name}
      .inner-prices
        if item.priceAdult && item.priceAdult > 0 && (!item.newPriceAdult || item.priceAdult > item.newPriceAdult)
          .inner-price-old
            | #{item.priceAdult.toLocaleString("vi-VN")} 
            span.inner-unit đ
        .inner-price-new
          | #{(item.newPriceAdult > 0 ? item.newPriceAdult : (item.priceAdult || 0)).toLocaleString("vi-VN")} 
          span.inner-unit đ
      .inner-desc
        .inner-desc-item
          | Ngày khởi hành:
          b #{item.departureDateFormatted}
        .inner-desc-item
          | Thời gian:
          b #{item.time}
      .inner-meta
        .inner-stock
          .inner-label Số chỗ còn:
          .inner-number #{item.stockAdult}
