// Top Header
.top-header
  .container
    .inner-wrap
      if(websiteInfo.phoneNumber)
        .inner-item
          i.fa-solid.fa-phone
          | #{websiteInfo.phoneNumber}
      if(websiteInfo.email)
        .inner-item
          i.fa-solid.fa-envelope
          | #{websiteInfo.email}
      if(websiteInfo.address)
        .inner-item
          i.fa-solid.fa-building
          | #{websiteInfo.address}
// End Top Header
// Header
header.header
  .container
    .inner-wrap
      button.inner-menu-mobile(type="button" aria-label="Mở menu")
        i.fa-solid.fa-bars
      .inner-logo
        a(href="/")
          img(
            alt=websiteInfo.websiteName
            src=websiteInfo.logo
            )
      nav.inner-menu
        ul
          li
            a.active(href="/") Trang chủ
          each item in categoryTree 
            li
              a(href=`/category/${item.slug}`) #{item.name}
              if(item.children && item.children.length > 0)
                i.fa-solid.fa-caret-down
                ul
                  each itemChild in item.children
                    li
                      a(href=`/category/${itemChild.slug}`) #{itemChild.name}
        .inner-overlay
      .header-actions
        .inner-cart
          a.header-cart-btn(href="/cart" title="Giỏ hàng đặt tour")
            img(
              alt="Cart" 
              src="/assets/images/icon-cart.svg"
              )
            span.header-cart-label Giỏ hàng
            span.header-cart-badge(mini-cart) 0
        .header-account
          if customer
            .header-account-dropdown(header-account-dropdown)
              button.header-account-trigger(type="button" header-account-trigger aria-expanded="false")
                .header-account-avatar
                  img(
                    src=customer.avatar || "/assets/images/icon-user.svg"
                    alt=`Ảnh đại diện của ${customer.fullName}`
                  )
                .header-account-info
                  span.header-account-greeting Xin chào,
                  span.header-account-name #{customer.fullName}
                i.fa-solid.fa-chevron-down.header-account-caret
              .header-account-menu(header-account-menu)
                a.header-account-item(href="/account/profile")
                  i.fa-regular.fa-id-badge
                  span Hồ sơ cá nhân
                a.header-account-item(href="/account/orders")
                  i.fa-solid.fa-suitcase-rolling
                  span Đơn đặt tour của tôi
                .header-account-divider
                form(action="/account/logout" method="post")
                  button.header-account-item.is-logout(type="submit")
                    i.fa-solid.fa-arrow-right-from-bracket
                    span Đăng xuất
          else
            a.header-account-login(href="/account/login") Đăng nhập
            a.header-account-register(href="/account/register") Đăng ký
// End Header
