doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(
      content="width=device-width, initial-scale=1.0" 
      name="viewport"
      )
    title #{pageTitle}
    link(
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" 
      rel="stylesheet"
      )
    link(
      href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" 
      rel="stylesheet"
      )
    link(
      href="https://cdnjs.cloudflare.com/ajax/libs/viewerjs/1.11.7/viewer.min.css" 
      rel="stylesheet"
      )
    link(
      rel="stylesheet" 
      href="https://unpkg.com/aos@2.3.1/dist/aos.css"
      )
    link(
      href="/assets/css/style.css" 
      rel="stylesheet"
      )
    link(
      rel="icon" 
      type="image/png" 
      href=websiteInfo.favicon
    )
  body

    - if (messages.success)
      div(class="alert alert-success" alert-time="3000")
        span #{messages.success}

    include ../partials/header.pug

    block main

    include ../partials/footer.pug

    include ../partials/box-contact.pug

    script(defer src="https://unpkg.com/just-validate@latest/dist/just-validate.production.min.js")
    script(defer src="https://cdnjs.cloudflare.com/ajax/libs/viewerjs/1.11.7/viewer.min.js")
    script(defer src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js")
    script(defer src="https://unpkg.com/aos@2.3.1/dist/aos.js")
    script(defer src="/assets/js/script.js")