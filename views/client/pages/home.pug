extends ../layouts/default.pug
include ../mixins/product-item.pug

block main 
  // Section 1
  .section-1
    .container
      .inner-wrap
        h1.inner-title(
          data-aos-duration="800" 
          data-aos="fade-up"
          )
          | SmartTour
          br
          | Al-Assisted Catalog Tour Booking Platform
        p.inner-desc(
          data-aos-delay="150" 
          data-aos-duration="800" 
          data-aos="fade-up"
          )
          | Khám phá hàng trăm hành trình trong nước và quốc tế với mức giá ưu đãi nhất.
          |   Chỉ cần mô tả mong muốn của bạn, trợ lý AI sẽ gợi ý lịch trình và điểm đến
          |   phù hợp nhất cho kỳ nghỉ trọn vẹn.
        form.ai-search-box#ai-search-form
          label(for="ai-tour-request")
            i.fa-solid.fa-wand-magic-sparkles
            | Tìm tour bằng AI
          textarea#ai-tour-request(
            name="aiTourRequest"
            maxlength="500"
            placeholder="Ví dụ: Tôi muốn tour du lịch đi Nha Trang, 3 ngày 2 đêm, giá 5 - 10 triệu."
          )
          button.ai-search-button(type="submit")
            i.fa-solid.fa-wand-magic-sparkles
            | Tìm tour
        section.ai-tour-results(ai-tour-results hidden aria-live="polite")
          p.ai-tour-results-message(ai-tour-message)
          .ai-tour-suggestions(ai-tour-suggestions)
