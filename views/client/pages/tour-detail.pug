extends ../layouts/default.pug
include ../mixins/box-breadcrumb.pug

block main
  // Breadcrumb
  +box-breadcrumb(breadcrumb)
  // End Breadcrumb

  // Section 10
  .section-10
    .container
      .inner-wrap
        .inner-left
          .box-image
            .inner-images-main
              .swiper.swiper-box-images-main
                .swiper-wrapper
                  each image in tourDetail.images
                    .swiper-slide
                      .inner-image
                        img(
                          alt=tourDetail.name
                          src=image
                        )
            .inner-images-thumb
              .swiper.swiper-box-images-thumb
                .swiper-wrapper
                  each image in tourDetail.images
                    .swiper-slide
                      .inner-image
                        img(
                          alt=tourDetail.name
                          src=image
                        )

          // Box Tour Schedule
          if tourDetail.schedules && tourDetail.schedules.length
            .box-tour-schedule
              .box-section-head
                i.fa-regular.fa-map
                span Lịch trình tour chi tiết
              .inner-list
                each item in tourDetail.schedules
                  .inner-item
                    .inner-title #{item.title}
                    .inner-content !{item.description}
          // End Box Tour Schedule

          // Box Tour Info
          .box-tour-info
            .inner-title
              i.fa-solid.fa-circle-info
              span Thông tin tour
            .inner-content !{tourDetail.information}
            .inner-read-more
              button.button-outline(type="button") Xem tất cả
          // End Box Tour Info

        .inner-right
          .box-tour-detail
            .inner-title-main
              i.fa-solid.fa-suitcase-rolling
              span Chuyến đi của bạn
            .inner-product
              .inner-image
                img(
                  alt=tourDetail.name
                  src=tourDetail.avatar
                )
              .inner-info
                .inner-title #{tourDetail.name}
                .inner-rating
                  .inner-stars
                    i.fa-solid.fa-star
                    i.fa-solid.fa-star
                    i.fa-solid.fa-star
                    i.fa-solid.fa-star
                    i.fa-solid.fa-star
                  .inner-number 500 lượt đánh giá
            .inner-meta
              .inner-item
                i.fa-solid.fa-clock
                span Thời gian:
                span.inner-highlight #{tourDetail.time}
              .inner-item
                i.fa-solid.fa-car
                span Phương tiện:
                span.inner-highlight #{tourDetail.vehicle}
              .inner-item
                i.fa-solid.fa-calendar-days
                span Ngày khởi hành:
                span.inner-highlight #{tourDetail.departureDateFormatted}
              .inner-item
                i.fa-solid.fa-users
                span Số chỗ còn:
                span.inner-highlight #{tourDetail.stockAdult} người lớn
            .inner-form
              .inner-group
                label.inner-label(for="location-from-select") Khởi hành tại
                select#location-from-select(location-from)
                  each city in cityList
                    option(value=city._id) #{city.name}
              .inner-group
                label.inner-label Số lượng hành khách
                .inner-list
                  .inner-item
                    .inner-item-label Người lớn:
                    .inner-item-input
                      input(
                        min="0"
                        max=tourDetail.stockAdult
                        value="1"
                        type="number"
                        input-stock-adult
                        price=tourDetail.newPriceAdult
                      )
                    .inner-item-price
                      span(stock-adult) 1
                      span  x 
                      span.inner-highlight #{tourDetail.newPriceAdult.toLocaleString("vi-VN")}
                  .inner-item
                    .inner-item-label Trẻ em:
                    .inner-item-input
                      input(
                        min="0"
                        max=tourDetail.stockChildren
                        value="0"
                        type="number"
                        input-stock-children
                        price=tourDetail.newPriceChildren
                      )
                    .inner-item-price
                      span(stock-children) 0
                      span  x 
                      span.inner-highlight #{tourDetail.newPriceChildren.toLocaleString("vi-VN")}
                  .inner-item
                    .inner-item-label Em bé:
                    .inner-item-input
                      input(
                        min="0"
                        max=tourDetail.stockBaby
                        value="0"
                        type="number"
                        input-stock-baby
                        price=tourDetail.newPriceBaby
                      )
                    .inner-item-price
                      span(stock-baby) 0
                      span  x 
                      span.inner-highlight #{tourDetail.newPriceBaby.toLocaleString("vi-VN")}
              .inner-total
                .inner-total-label Tổng cộng
                .inner-total-price
                  span(total-price) #{tourDetail.newPriceAdult.toLocaleString("vi-VN")}
                  |  đ
              button.inner-button-add-cart(type="button" tour-id=tourDetail.id)
                i.fa-solid.fa-cart-plus
                span Thêm vào giỏ hàng
  // End Section 10
