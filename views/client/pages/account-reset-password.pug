extends ../layouts/default-new.pug

block main
  .customer-auth-page
    .customer-auth-card
      h1 Đặt lại mật khẩu
      p.inner-desc Tạo mật khẩu mới cho tài khoản của bạn.
      form#customer-reset-password-form(action="/account/reset-password" method="post")
        input(type="hidden" name="email" value=email)
        input(type="hidden" name="token" value=token)
        .customer-auth-field
          label(for="customer-new-password") Mật khẩu mới
          input#customer-new-password(type="password" name="password" autocomplete="new-password" minlength="8" required)
          small Ít nhất 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt (@$!%*?&).
        .customer-auth-field
          label(for="customer-confirm-password") Nhập lại mật khẩu mới
          input#customer-confirm-password(type="password" name="confirmPassword" autocomplete="new-password" minlength="8" required)
        button(type="submit") Cập nhật mật khẩu
      p.customer-auth-switch
        a(href="/account/login") Quay lại đăng nhập
      p.customer-auth-error#customer-auth-error(role="alert" hidden)

  script(src="/assets/js/customer-account.js")
