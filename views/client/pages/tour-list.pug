  .section-9
    .container
      .inner-wrap
        .inner-left
          // Box Filter
          .box-filter
            .inner-head
              .inner-title Bộ lọc
              i.fa-solid.fa-filter
            .inner-body
              .inner-group
                lable.inner-lable(for="") Điểm đi
                select(name="locationFrom")
                  option(value="") Tất cả điểm đi
                  each item in cityList
                    // `cityList` comes from a lean query, so it has `_id` but no Mongoose `id` virtual.
                    option(value=item._id) #{item.name}
              .inner-group
                lable.inner-lable(for="") Điểm đến
                select(name="locationTo")
                  option(value="") Tất cả điểm đến
                  each item in cityList
                    option(value=item.name) #{item.name}
              .inner-group
                lable.inner-lable(for="") Ngày khởi hành
                input(
                  name="departureDate" 
                  type="date"
                  )
              .inner-group
                lable.inner-lable(for="") Số lượng hành khách
                .inner-input-list
                  .inner-input-item
                    span Người lớn:
                    input(
                      value="0" 
                      name="stockAdult" 
                      type="number"
                      )
                  .inner-input-item
                    span Trẻ em:
                    input(
                      value="0" 
                      name="stockChildren" 
                      type="number"
                      )
                  .inner-input-item
                    span Em bé:
                    input(
                      value="0" 
                      name="stockBaby" 
                      type="number"
                      )
              .inner-group
                lable.inner-lable(for="") Mức giá
                select(name="price")
                  option(value="") Tất cả khoảng giá
                  option(value="0-999999") Dưới 1 triệu
                  option(value="1000000-3000000") Từ 1 triệu đến 3 triệu
                  option(value="3000000-6000000") Từ 3 triệu đến 6 triệu
                  option(value="6000000-10000000") Từ 6 triệu đến 10 triệu
                  option(value="10000000-1000000000") Trên 10 triệu
              .inner-group
                button.inner-button Áp dụng
          // End Box Filter
          .inner-overlay
        .inner-right
          .inner-info-1
            h2.inner-title #{category.name}
            .inner-desc
              | !{category.description}
          .inner-info-2
            .inner-sort
              .inner-label Sắp xếp:
              .inner-list
                button
                  | Giá tăng dần
                  i.fa-solid.fa-square-caret-up
                button
                  | Giá giảm dần
                  i.fa-solid.fa-square-caret-down
                button.active
                  | Khuyến mãi hot
                  i.fa-solid.fa-tag
                button
                  | Xem nhiều
                  i.fa-solid.fa-eye
            .inner-count-record
              | Tất cả:
              b #{pagination ? pagination.totalRecords : tourListSection9.length} Tour
            button.inner-filter-mobile
              span.inner-title Bộ lọc
              i.fa-solid.fa-filter
          .inner-list-tour
            each item in tourListSection9
              +product-item(item)
          // Pagination
          if pagination && pagination.totalRecords > 0
            - const currentPage = pagination.currentPage || 1;
            - const totalPages = Math.max(1, pagination.totalPages || 1);
            .box-pagination(client-pagination)
              button.inner-page-nav(
                type="button"
                data-page=(currentPage - 1)
                disabled=(currentPage <= 1)
              )
                i.fa-solid.fa-chevron-left
                span Trang trước
              - for (let i = 1; i <= totalPages; i++)
                button(
                  type="button"
                  class=(i === currentPage ? "active" : "")
                  data-page=i
                ) #{i}
              button.inner-page-nav(
                type="button"
                data-page=(currentPage + 1)
                disabled=(currentPage >= totalPages)
              )
                span Trang sau
                i.fa-solid.fa-chevron-right
          // End Pagination
  // End Section 9
