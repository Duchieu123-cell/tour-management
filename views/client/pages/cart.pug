extends ../layouts/default.pug

block main
  // Section 11
  .section-11(page-cart)
    .container
      .inner-wrap
        .inner-head
          .cart-title-group
            .cart-title-icon
              i.fa-solid.fa-bag-shopping
            .inner-title Giỏ hàng của bạn
            span.cart-count-pill(cart-count-label) 0 tour
          a.inner-back(href="/category/tour-trong-nuoc")
            span Tiếp tục xem tour
            i.fa-solid.fa-angle-right

        .inner-tour-list(cart-list)

        .cart-summary-card
          .inner-coupon
            form#coupon-form(action="")
              input#coupon-input(
                placeholder="Nhập mã giảm giá"
                name="coupon"
                type="text"
              )
              button(type="submit") Áp dụng mã
          .inner-list-price
            .inner-item
              .inner-label Tạm tính:
              .inner-price
                span(cart-sub-total) 0
                |  đ
            .inner-item
              .inner-label Giảm giá:
              .inner-price.is-discount
                span -
                span(cart-discount) 0
                |  đ
            .inner-item.is-total
              .inner-label Tổng thanh toán:
              .inner-price-highlight
                span(cart-total) 0
                |  đ
  // End Section 11

  // Section 12
  .section-12
    .container
      .inner-wrap
        form#order-form(action="")
          .inner-info
            .cart-section-head
              .inner-title-main
                i.fa-regular.fa-address-card
                span Thông tin khách hàng
              p.cart-section-sub Vui lòng điền thông tin liên hệ để chúng tôi xác nhận giữ chỗ cho bạn.
            .inner-inputs
              .inner-input
                input#fullname-input(
                  placeholder="Họ và tên"
                  name="fullName"
                  type="text"
                )
              .inner-input
                input#phone-input(
                  placeholder="Số điện thoại"
                  name="phoneNumber"
                  type="number"
                )
            textarea(
              placeholder="Ghi chú thêm (yêu cầu phòng, suất ăn, giờ đón...)"
              name="note"
            )
          .inner-method
            .cart-section-head
              .inner-title-main
                i.fa-regular.fa-credit-card
                span Chọn phương thức thanh toán
            .inner-list
              .inner-item
                input#methodMoney(
                  value="money"
                  name="method"
                  type="radio"
                )
                label(for="methodMoney") Thanh toán tiền mặt tại văn phòng
              .inner-item
                input#methodMomo(
                  value="momo"
                  name="method"
                  type="radio"
                )
                label(for="methodMomo") Ví MoMo
              .inner-item
                input#methodZalopay(
                  value="zalopay"
                  name="method"
                  type="radio"
                )
                label(for="methodZalopay") ZaloPay
              .inner-item
                input#methodVnpay(
                  value="vnpay"
                  name="method"
                  type="radio"
                )
                label(for="methodVnpay") VNPay
              .inner-item
                input#methodBank(
                  value="bank"
                  name="method"
                  type="radio"
                )
                label(for="methodBank") Chuyển khoản ngân hàng
            .inner-info-bank
              .inner-title
                i.fa-solid.fa-building-columns
                span Thông tin chuyển khoản
              .inner-text Ngân hàng: Vietcombank
              .inner-text Tên tài khoản: Le Van A
              .inner-text STK: 0123456789
          .inner-button
            button(type="submit")
              i.fa-solid.fa-check-circle
              span Đặt Tour Ngay
  // End Section 12
