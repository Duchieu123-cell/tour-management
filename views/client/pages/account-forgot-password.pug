extends ../layouts/default-new.pug

block main
  .customer-auth-page
    .customer-auth-card
      h1 Quên mật khẩu
      p.inner-desc Nhập email đã đăng ký. Nếu tài khoản tồn tại, hướng dẫn đặt lại sẽ được gửi đến email đó.
      form#customer-forgot-password-form(action="/account/forgot-password" method="post")
        .customer-auth-field
          label(for="customer-email") Email
          input#customer-email(type="email" name="email" autocomplete="email" required)
        button(type="submit") Gửi hướng dẫn
      p.customer-auth-switch
        a(href="/account/login") Quay lại đăng nhập
      p.customer-auth-error#customer-auth-error(role="status" aria-live="polite" hidden)

  script(src="/assets/js/customer-account.js")
