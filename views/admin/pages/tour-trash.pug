extends ../layouts/layout-default.pug

block main
  if(account.permissions.includes("tour-trash"))
    h1.box-title Thùng rác tour

    //- Section 5
    .section-5 
      .inner-wrap
        .inner-change-status(
          change-multi 
          data-api=`/${pathAdmin}/tour/trash/change-multi`
        )
          .inner-item
            select
              option(value="") --Hành động--
              option(value="undo") Khôi phục
              option(value="delete-permanent") Xóa vĩnh viễn
          .inner-item
            button Áp dụng
        .inner-search
          <i class="fa-solid fa-magnifying-glass"></i>
          input(type="text" placeholder="Tìm kiếm")  
    //- End Section 5

    //- Section 6
    .section-6 
      .table-2 
        table
          thead
            tr
              th(class="inner-center")
                input(type="checkbox" class="inner-check" check-all)
              th Tên tour
              th Ảnh đại diện
              th Giá
              th Còn lại
              th(class="inner-center") Vị trí 
              th(class="inner-center") Trạng thái
              th Xóa bởi
              th Hành động 
          tbody
            each item in tourList
              tr
                td(class="inner-center")
                  input(type="checkbox" class="inner-check" check-item=item.id)
                td #{item.name}
                td 
                  img(src=item.avatar, class="inner-avatar")
                td
                  div NL: #{(item.newPriceAdult > 0 ? item.newPriceAdult : item.priceAdult).toLocaleString("vi-VN")}đ
                  div TE: #{(item.newPriceChildren > 0 ? item.newPriceChildren : item.priceChildren).toLocaleString("vi-VN")}đ
                  div EB: #{(item.newPriceBaby > 0 ? item.newPriceBaby : item.priceBaby).toLocaleString("vi-VN")}đ
                td
                  div NL: #{item.stockAdult}
                  div TE: #{item.stockChildren}
                  div EB: #{item.stockBaby}
                td(class="inner-center") #{item.position}
                td(class="inner-center")
                  if(item.status == "active")
                    .badge.badge-green Hoạt động
                  else if(item.status == "inactive")
                    .badge.badge-red Tạm dừng
                  else if(item.status == "deleted")
                    .badge.badge-orange Xóa
                td 
                  div #{item.deletedByFullName}
                  div.inner-time #{item.deletedAtFormatted} 
                td
                  .inner-buttons
                    button(
                      class="inner-undo"
                      button-undo
                      data-api=`/${pathAdmin}/tour/undo/${item.id}`
                    ) <i class="fa-solid fa-arrow-rotate-left"></i>
                    button(
                      class="inner-delete"
                      button-delete
                      data-api=`/${pathAdmin}/tour/delete-permanent/${item.id}`
                    ) <i class="fa-regular fa-trash-can"></i>
    //- End Section 6

    //- Section 7
    .section-7  
      span.inner-label Hiển thị 1 - 9 của 78
      select(class="inner-pagination")
        option Trang 1
        option Trang 2
        option Trang 3
    //- End Section 7