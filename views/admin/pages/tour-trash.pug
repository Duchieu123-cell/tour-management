extends ../layouts/layout-default.pug
include ../mixins/pagination.pug
include ../mixins/bulk-action.pug

block main
  if(account.permissions.includes("tour-trash"))
    h1.box-title Thùng rác tour

    //- Section 5
    .section-5 
      .inner-wrap
        .inner-search
          <i class="fa-solid fa-magnifying-glass"></i>
          input(type="text" placeholder="Tìm kiếm" search)  
        .inner-button-create
          a(href=`/${pathAdmin}/tour/list` style="background-color: #6C757D;") <i class="fa-solid fa-arrow-left"></i> Quay lại danh sách
    //- End Section 5

    +bulkAction(`/${pathAdmin}/tour/trash/change-multi`, [
      { value: "undo", label: "Khôi phục" },
      { value: "delete-permanent", label: "Xóa vĩnh viễn" }
    ])

    //- Section 6
    .section-6 
      .table-2 
        table
          thead
            tr
              th(class="inner-center")
              th Tên tour
              th Ảnh đại diện
              th Giá
              th Còn lại
              th(class="inner-center") Vị trí 
              th(class="inner-center") Trạng thái
              th Xóa bởi
              th.inner-center Hành động 
          tbody
            if(tourList && tourList.length > 0)
              each item in tourList
                tr
                  td(class="inner-center")
                    input(type="checkbox" class="inner-check" check-item=item.id)
                  td.inner-col-title #{item.name}
                  td 
                    img(src=item.avatar, class="inner-avatar")
                  td
                    div.inner-nowrap NL: #{(item.newPriceAdult > 0 ? item.newPriceAdult : item.priceAdult).toLocaleString("vi-VN")}đ
                    div.inner-nowrap TE: #{(item.newPriceChildren > 0 ? item.newPriceChildren : item.priceChildren).toLocaleString("vi-VN")}đ
                    div.inner-nowrap EB: #{(item.newPriceBaby > 0 ? item.newPriceBaby : item.priceBaby).toLocaleString("vi-VN")}đ
                  td
                    div.inner-nowrap NL: #{item.stockAdult}
                    div.inner-nowrap TE: #{item.stockChildren}
                    div.inner-nowrap EB: #{item.stockBaby}
                  td(class="inner-center") #{item.position}
                  td(class="inner-center")
                    if(item.status == "active")
                      .badge.badge-green Hoạt động
                    else if(item.status == "inactive")
                      .badge.badge-red Tạm dừng
                    else if(item.status == "deleted")
                      .badge.badge-orange Xóa
                  td 
                    div.inner-nowrap #{item.deletedByFullName}
                    div.inner-time.inner-nowrap #{item.deletedAtFormatted} 
                  td.inner-center
                    .inner-buttons
                      button(
                        class="inner-undo"
                        button-undo
                        data-api=`/${pathAdmin}/tour/undo/${item.id}`
                      ) <i class="fa-solid fa-arrow-rotate-left"></i>
                      button(
                        class="inner-delete"
                        button-delete
                        data-api=`/${pathAdmin}/tour/delete-permanent/${item.id}`
                      ) <i class="fa-regular fa-trash-can"></i>
            else
              tr
                td(colspan="9" class="inner-center") Thùng rác trống
    //- End Section 6

    //- Section 7
    +pagination(pagination, tourList ? tourList.length : 0)
    //- End Section 7
