extends ../layouts/layout-default.pug
include ../mixins/pagination.pug

block main
  h1.box-title Tài khoản quản trị

  //- Section 4
  .section-4 
    .inner-wrap
      .inner-item.inner-label
        <i class="fa-solid fa-filter"></i> Bộ lọc
      .inner-item
        span.inner-field-label Trạng thái
        select(filter-status)
          option(value="") -- Tất cả trạng thái --
          option(value="active") Hoạt động 
          option(value="inactive") Tạm dừng
          option(value="initial") Khởi tạo
      .inner-item.inner-date
        span.inner-field-label Ngày tạo
        .inner-date-inputs
          span.inner-date-label Từ
          input(type="date" filter-start-date aria-label="Từ ngày")
          span.inner-date-sep -
          span.inner-date-label Đến
          input(type="date" filter-end-date aria-label="Đến ngày")
      .inner-item
        span.inner-field-label Nhóm quyền
        select
          option(value="") -- Tất cả nhóm quyền --
          option(value="") Quản trị viên 
          option(value="") Quản lý tour 
          option(value="") Quản lý đơn hàng  
      .inner-item.inner-reset(filter-reset)
        <i class="fa-solid fa-rotate-left"></i> Xóa bộ lọc
  //- End Section 4

  //- Section 5
  .section-5 
    .inner-wrap
      .inner-search
        <i class="fa-solid fa-magnifying-glass"></i>
        input(type="text" placeholder="Tìm kiếm")  
      .inner-button-create
        a(href=`/${pathAdmin}/setting/account-admin/create`)  + Tạo mới  
  //- End Section 5

  //- Section 6
  .section-6 
    .table-2 
      table
        thead
          tr
            th Họ tên
            th(class="inner-center") Ảnh đại diện
            th Email 
            th(class="inner-center") Số điện thoại
            th Nhóm quyền 
            th Chức vụ 
            th(class="inner-center") Trạng thái
            th.inner-center Hành động 
        tbody
          each admin in accountAdminList
            tr
              td.inner-col-name #{admin.fullName}
              td.inner-center
                img(src=admin.avatar, class="inner-avatar") 
              td.inner-col-email #{admin.email}
              td(class="inner-center inner-nowrap") #{admin.phoneNumber}
              td.inner-nowrap #{admin.roleName}
              td.inner-nowrap #{admin.positionCompany}
              td(class="inner-center")
                if admin.status == 'inactive'
                  .badge.badge-red Dừng hoạt động
                else if admin.status == 'active'
                  .badge.badge-green Hoạt động
                else if admin.status == 'initial'
                  .badge.badge-orange Khởi tạo
              td.inner-center
                .inner-buttons
                  a(
                    href=`/${pathAdmin}/setting/account-admin/edit/${admin._id}`
                    class="inner-edit"
                  ) <i class="fa-regular fa-pen-to-square"></i> 
                  button(
                    class="inner-delete"
                    button-delete 
                    data-api=`/${pathAdmin}/setting/account-admin/delete/${admin._id}`
                  ) <i class="fa-regular fa-trash-can"></i>
  //- End Section 6

  //- Section 7
  +pagination(pagination, accountAdminList ? accountAdminList.length : 0)
  //- End Section 7