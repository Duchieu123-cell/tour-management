extends ../layouts/layout-default.pug
include ../mixins/pagination.pug

block main
  h1.box-title Quản lý đơn hàng 

  //- Section 4
  .section-4 
    .inner-wrap
      .inner-item.inner-label
        <i class="fa-solid fa-filter"></i> Bộ lọc
      .inner-item
        span.inner-field-label Trạng thái đơn
        select(filter-status)
          option(value="") -- Tất cả trạng thái --
          option(value="initial") Khởi tạo
          option(value="done") Hoàn thành
          option(value="cancel") Hủy
      .inner-item.inner-date
        span.inner-field-label Ngày đặt
        .inner-date-inputs
          span.inner-date-label Từ
          input(type="date" filter-start-date aria-label="Từ ngày")
          span.inner-date-sep -
          span.inner-date-label Đến
          input(type="date" filter-end-date aria-label="Đến ngày")
      .inner-item
        span.inner-field-label Phương thức thanh toán
        select
          option(value="") -- Tất cả PTTT --
          option(value="money") Tiền mặt
          option(value="momo") Ví MoMo
          option(value="vnpay") VNPay
          option(value="zalopay") ZaloPay
          option(value="bank") Chuyển khoản
      .inner-item
        span.inner-field-label Trạng thái thanh toán
        select
          option(value="") -- Tất cả thanh toán --
          option(value="paid") Đã thanh toán
          option(value="unpaid") Chưa thanh toán
      .inner-item.inner-reset(filter-reset)
        <i class="fa-solid fa-rotate-left"></i> Xóa bộ lọc
  //- End Section 4

  //- Section 5
  .section-5 
    .inner-wrap
      .inner-search
        <i class="fa-solid fa-magnifying-glass"></i>
        input(type="text" placeholder="Tìm kiếm")
  //- End Section 5

  //- Section 6
  .section-6 
    .table-2 
      table
        thead 
          tr 
            th Mã
            th Thông tin khách
            th Danh sách tour
            th Thanh toán
            th Trạng thái
            th.inner-text-right Ngày đặt
            th.inner-center Hành động 
        tbody
          each orderDetail in orderList
            tr
              td
                .inner-code.inner-nowrap #{orderDetail.code}
              td
                .inner-info
                  div Họ tên: #{orderDetail.fullName}
                  div SĐT: #{orderDetail.phoneNumber}
                  div Ghi chú: #{orderDetail.note}
              td
                .inner-list
                  each item in orderDetail.items
                    .inner-item
                      .inner-image 
                        img(src=item.avatar, alt=item.name)
                      .inner-content
                        .inner-main #{item.name}
                        if(item.quantityAdult > 0)
                          .inner-quantity Người lớn: #{item.quantityAdult} x #{item.newPriceAdult.toLocaleString("vi-VN")}đ
                        if(item.quantityChildren > 0)
                          .inner-quantity Trẻ em: #{item.quantityChildren} x #{item.newPriceChildren.toLocaleString("vi-VN")}đ
                        if(item.quantityBaby > 0)
                          .inner-quantity Em bé: #{item.quantityBaby} x #{item.newPriceBaby.toLocaleString("vi-VN")}đ
              td 
                div.inner-nowrap Tổng tiền: #{orderDetail.subTotal.toLocaleString("vi-VN")}đ
                div.inner-nowrap Giảm 0đ
                div.inner-nowrap Mã giảm: 0
                div.inner-nowrap Thanh toán #{orderDetail.total.toLocaleString("vi-VN")}đ
                div.inner-nowrap PTTT: #{orderDetail.paymentMethodName}
                div.inner-nowrap TTTT: #{orderDetail.paymentStatusName}
              td
                div(class=`badge badge-${orderDetail.statusColor}`) #{orderDetail.statusName}
              td.inner-text-right.inner-nowrap
                div #{orderDetail.createdAtFormatTime}
                div #{orderDetail.createdAtFormatDate}
              td.inner-center
                .inner-buttons
                  a(href=`/${pathAdmin}/order/edit/${orderDetail.id}` class="inner-edit") <i class="fa-regular fa-pen-to-square"></i> 
                  button(
                    class="inner-delete"
                    button-delete 
                    data-api=`/${pathAdmin}/order/delete/${orderDetail.id}`
                  ) <i class="fa-regular fa-trash-can"></i>
  //- End Section 6

  //- Section 7
  +pagination(pagination, orderList ? orderList.length : 0)
  //- End Section 7