extends ../layouts/layout-default.pug

block main
  h1.box-title Quản lý người dùng

  //- Section 4: Bộ lọc
  .section-4 
    .inner-wrap
      .inner-item.inner-label
        <i class="fa-solid fa-filter"></i> Bộ lọc
      .inner-item
        select(filter-status)
          option(value="") Trạng thái
          option(value="active") Hoạt động 
          option(value="inactive") Tạm dừng
      .inner-item.inner-date
        input(type="date" filter-start-date)
        span -
        input(type="date" filter-end-date)
      .inner-item.inner-reset(filter-reset)
        <i class="fa-solid fa-rotate-left"></i> Xóa bộ lọc
  //- End Section 4

  //- Section 5: Thao tác & Tìm kiếm
  .section-5 
    .inner-wrap
      .inner-change-status(
        change-multi 
        data-api=`/${pathAdmin}/user/change-multi`
      )
        .inner-item
          select
            option(value="") --Hành động--
            option(value="active") Hoạt động
            option(value="inactive") Dừng hoạt động
            option(value="delete") Xóa
        .inner-item
          button Áp dụng
      .inner-search
        <i class="fa-solid fa-magnifying-glass"></i>
        input(type="text" placeholder="Tìm kiếm theo tên, email, sđt..." search)
      .inner-button-create
        button(type="button" button-create-user) + Tạo mới
      .inner-button-trash
        a(href=`/${pathAdmin}/user/trash`) Thùng rác
  //- End Section 5

  //- Section 6: Bảng người dùng
  .section-6 
    .table-2 
      table
        thead
          tr
            th(class="inner-center")
              input(type="checkbox" class="inner-check" check-all)
            th Họ tên
            th Ảnh đại diện
            th Email 
            th(class="inner-center") Số điện thoại
            th Địa chỉ
            th(class="inner-center") Trạng thái
            th(class="inner-center inner-sortable" title="Nhấp để đổi thứ tự sắp xếp")
              .inner-sort-wrap
                span Ngày tạo
                button(
                  type="button"
                  class=`button-sort ${(sortKey == 'createdAt' ? 'active' : '')}`
                  button-sort="createdAt"
                  data-value=(sortKey == 'createdAt' ? sortValue : 'desc')
                )
                  if (sortKey == 'createdAt' && sortValue == 'asc')
                    <i class="fa-solid fa-arrow-up-wide-short"></i>
                  else if (sortKey == 'createdAt' && sortValue == 'desc')
                    <i class="fa-solid fa-arrow-down-wide-short"></i>
                  else
                    <i class="fa-solid fa-sort"></i>
            th Hành động 
        tbody
          if(userList && userList.length > 0)
            each item in userList
              tr
                td(class="inner-center")
                  input(type="checkbox" class="inner-check" check-item=item._id)
                td #{item.fullName}
                td 
                  img(src=(item.avatar || "/admin/assets/images/batman.png"), class="inner-avatar")
                td #{item.email}
                td(class="inner-center") #{item.phone || "---"}
                td #{item.address || "---"}
                td(class="inner-center")
                  if(item.status == "active")
                    button(
                      type="button"
                      class="badge badge-green"
                      button-change-status
                      data-id=item._id
                      data-status="inactive"
                      title="Nhấp để chuyển sang Tạm dừng"
                    ) Hoạt động
                  else
                    button(
                      type="button"
                      class="badge badge-red"
                      button-change-status
                      data-id=item._id
                      data-status="active"
                      title="Nhấp để chuyển sang Hoạt động"
                    ) Tạm dừng
                td(class="inner-center") #{item.createdAtFormatted}
                td
                  .inner-buttons
                    button(
                      class="inner-edit" 
                      type="button"
                      button-edit-user 
                      data-id=item._id
                      title="Chỉnh sửa thông tin"
                    ) <i class="fa-regular fa-pen-to-square"></i>
                    button(
                      class="inner-delete" 
                      button-delete 
                      data-api=`/${pathAdmin}/user/delete/${item._id}`
                      title="Xóa người dùng"
                    ) <i class="fa-regular fa-trash-can"></i>
          else
            tr
              td(colspan="9" class="inner-center") Không có dữ liệu người dùng
  //- End Section 6

  //- Section 7: Phân trang
  if(pagination && pagination.totalRecords > 0)
    .section-7  
      span.inner-label Hiển thị #{pagination.skip + 1} - #{pagination.skip + userList.length} của #{pagination.totalRecords}
      select(class="inner-pagination" pagination)
        - for (let i = 1; i <= pagination.totalPages; i++)
          option(value=i) Trang #{i}
  //- End Section 7

  //- Include Modals
  include ../partials/user-modals.pug

  script(src="/admin/assets/js/user.js")
