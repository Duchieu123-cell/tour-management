extends ../layouts/layout-default.pug

block main
  h1.box-title Đơn hàng: #{orderDetail.code}

  //- Section 8
  .section-8  
    form#order-edit-form
      .inner-group(style="display: none;")
          input(type="text" name="id" value=orderDetail.id)
      .inner-group
        label(for="fullName" class="inner-label") Tên khách hàng
        input(type="text" id="fullName" name="fullName" value=orderDetail.fullName)
      .inner-group
        label(for="phoneNumber" class="inner-label") Số điện thoại
        input(type="number" id="phoneNumber" name="phoneNumber" value=orderDetail.phoneNumber)
      .inner-group.inner-two-col
        label(for="note" class="inner-label") Ghi chú
        textarea(id="note" name="note") #{orderDetail.note}
      .inner-group
        label(for="paymentMethod" class="inner-label") Phương thức thanh toán
        select(id="paymentMethod" name="paymentMethod")
          option(
            value="money"
            selected=(orderDetail.paymentMethod == 'money')
          ) Tiền mặt 
          option(
            value="bank"
            selected=(orderDetail.paymentMethod == 'bank')
          ) Tài khoản ngân hàng
          option(
            value="momo"
            selected=(orderDetail.paymentMethod == 'momo')
          ) Ví Momo
          option(
            value="vnpay"
            selected=(orderDetail.paymentMethod == 'vnpay')
          ) VNPay 
          option(
            value="zalopay"
            selected=(orderDetail.paymentMethod == 'zalopay')          
          ) ZaloPay 
      .inner-group
        label(for="paymentStatus" class="inner-label") Trạng thái thanh toán
        select(id="paymentStatus" name="paymentStatus")
          option(
            value="paid"
            selected=(orderDetail.paymentStatus == 'paid')
          ) Đã thanh toán
          option(
            value="unpaid"
            selected=(orderDetail.paymentStatus == 'unpaid')
          ) Chưa thanh toán
      .inner-group
        label(for="orderDate" class="inner-label") Ngày đặt
        input(type="datetime-local" id="orderDate" name="orderDate" value=orderDetail.createdAtFormat readonly)
      .inner-group
        label(for="status" class="inner-label") Trạng thái
        select(id="status" name="status")
          option(
            value="initial"
            selected=(orderDetail.status == 'initial')
          ) Khởi tạo
          option(
            value="done"
            selected=(orderDetail.status == 'done')
          ) Hoàn thành
          option(
            value="cancel"
            selected=(orderDetail.status == 'cancel')
          ) Hủy 
      .inner-group
        label(class="inner-label") Danh sách tour
        .inner-order-list
          each item in orderDetail.items
            .inner-order-item
              .inner-order-image
                img(src=item.avatar, alt=item.name)
              .inner-order-content
                .inner-order-name #{item.name}
                if(item.quantityAdult > 0)
                  .inner-order-text Người lớn: #{item.quantityAdult} x #{item.newPriceAdult.toLocaleString("vi-VN")}đ
                if(item.quantityChildren > 0)
                  .inner-order-text Trẻ em: #{item.quantityChildren} x #{item.newPriceChildren.toLocaleString("vi-VN")}đ
                if(item.quantityBaby > 0)
                  .inner-order-text Em bé: #{item.quantityBaby} x #{item.newPriceBaby.toLocaleString("vi-VN")}đ
                .inner-order-text Ngày khởi hành: #{item.departureDateFormat}
                .inner-order-text Khởi hành tại: #{item.locationFromName}
      .inner-group
        label(class="inner-label") Thanh toán
        .inner-order-total
          div Tổng tiền #{orderDetail.subTotal.toLocaleString("vi-VN")}đ
          div Giảm 0đ
          div Mã giảm: 0
          div Thanh toán: <span class="inner-order-price">#{orderDetail.total.toLocaleString("vi-VN")}đ</span> 
      .inner-button.inner-two-col
        button Cập nhật
    .inner-back
      a(href=`/${pathAdmin}/order/list`) Quay lại danh sách
  //- End Section 8