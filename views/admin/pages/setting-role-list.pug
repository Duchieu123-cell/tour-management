extends ../layouts/layout-default.pug

block main
  h1.box-title Nhóm quyền 

  //- Section 5
  .section-5 
    .inner-wrap
      .inner-search
        <i class="fa-solid fa-magnifying-glass"></i>
        input(type="text" placeholder="Tìm kiếm")  
      .inner-button-create
        a(href=`/${pathAdmin}/setting/role/create`)  + Tạo mới  
  //- End Section 5

  //- Section 6
  .section-6 
    .table-2 
      table
        thead
          tr
            th Tên nhóm quyền  
            th Mô tả ngắn 
            th(class="inner-center") Hành động 
        tbody
          each item in roleList
            tr
              td #{item.name}
              td #{item.description}
              td(class="inner-center")
                .inner-buttons
                  a(
                    href=`/${pathAdmin}/setting/role/edit/${item._id}`
                    class="inner-edit"
                  ) <i class="fa-regular fa-pen-to-square"></i> 
                  button(
                    class="inner-delete"
                    button-delete 
                    data-api=`/${pathAdmin}/setting/role/delete/${item._id}`
                  ) <i class="fa-regular fa-trash-can"></i>
  //- End Section 6