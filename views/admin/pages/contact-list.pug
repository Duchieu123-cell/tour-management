extends ../layouts/layout-default.pug
include ../mixins/pagination.pug

block main
  h1.box-title Thông tin liên hệ

  //- Section 4
  .section-4 
    .inner-wrap
      .inner-item.inner-label
        <i class="fa-solid fa-filter"></i> Bộ lọc
      .inner-item.inner-date
        span.inner-field-label Ngày gửi
        .inner-date-inputs
          span.inner-date-label Từ
          input(type="date" filter-start-date aria-label="Từ ngày")
          span.inner-date-sep -
          span.inner-date-label Đến
          input(type="date" filter-end-date aria-label="Đến ngày")
      .inner-item.inner-reset(filter-reset)
        <i class="fa-solid fa-rotate-left"></i> Xóa bộ lọc
  //- End Section 4

  //- Section 5
  .section-5 
    .inner-wrap
      .inner-change-status
        .inner-item
          select
            option(value="") --Hành động--
            option(value="") Hoạt động
            option(value="") Dừng hoạt động
            option(value="") Xóa
        .inner-item
          button Áp dụng
      .inner-search
        <i class="fa-solid fa-magnifying-glass"></i>
        input(type="text" placeholder="Tìm kiếm")
  //- End Section 5

  //- Section 6
  .section-6 
    .table-2 
      table
        thead
          tr
            th(class="inner-center")
              input(type="checkbox" class="inner-check")
            th Email 
            th Ngày tạo
            th(class="inner-center") Hành động 
        tbody
          each item in contactList
            tr
              td(class="inner-center")
                input(type="checkbox" class="inner-check")
              td #{item.email}
              td #{item.createdAtFormatted}
              td(class="inner-center")
                .inner-buttons
                  button(
                    class="inner-delete"
                    button-delete 
                    data-api=`/${pathAdmin}/contact/delete/${item._id}`
                  ) <i class="fa-regular fa-trash-can"></i>
  //- End Section 6

  //- Section 7
  +pagination(pagination, contactList ? contactList.length : 0)
  //- End Section 7