extends ../layouts/layout-default.pug
include ../mixins/option.pug
include ../mixins/pagination.pug

block main
  if(account.permissions.includes("tour-view"))
    h1.box-title Quản lý tour

    //- Section 4
    .section-4 
      .inner-wrap
        .inner-item.inner-label
          <i class="fa-solid fa-filter"></i> Bộ lọc
        .inner-item
          span.inner-field-label Trạng thái
          select(filter-status)
            option(value="") -- Tất cả trạng thái --
            option(value="active") Hoạt động 
            option(value="inactive") Tạm dừng
        .inner-item
          span.inner-field-label Người tạo
          select(filter-created-by)
            option(value="") -- Tất cả người tạo --
            each admin in adminAccountList
              option(value=admin._id) #{admin.fullName}
        .inner-item.inner-date
          span.inner-field-label Ngày tạo
          .inner-date-inputs
            span.inner-date-label Từ
            input(type="date" filter-start-date aria-label="Từ ngày")
            span.inner-date-sep -
            span.inner-date-label Đến
            input(type="date" filter-end-date aria-label="Đến ngày")
        .inner-item
          span.inner-field-label Danh mục
          select(filter-category)
            option(value="") -- Tất cả danh mục --
            +option(categoryList)
        .inner-item
          span.inner-field-label Mức giá
          select(filter-price)
            option(value="") -- Tất cả mức giá --
            option(value="0-2000000") Dưới 2tr
            option(value="2000000-4000000") 2tr đến 4tr
            option(value="4000000-8000000") 4tr đến 8tr
            option(value="8000000-1000000000") Trên 8tr  
        .inner-item.inner-reset(filter-reset)
          <i class="fa-solid fa-rotate-left"></i> Xóa bộ lọc
    //- End Section 4

    //- Section 5
    .section-5 
      .inner-wrap
        .inner-change-status(
          change-multi 
          data-api=`/${pathAdmin}/tour/change-multi`
        )
          .inner-item
            select
              option(value="") --Hành động--
              if(account.permissions.includes("tour-edit"))
                option(value="active") Hoạt động
                option(value="inactive") Dừng hoạt động
              if(account.permissions.includes("tour-delete"))
                option(value="delete") Xóa
          .inner-item
            button Áp dụng
        .inner-search
          <i class="fa-solid fa-magnifying-glass"></i>
          input(type="text" placeholder="Tìm kiếm" search)  
        if(account.permissions.includes("tour-create"))
          .inner-button-create
            a(href=`/${pathAdmin}/tour/create`)  + Tạo mới 
        if(account.permissions.includes("tour-trash"))
          .inner-button-trash
            a(href=`/${pathAdmin}/tour/trash`) Thùng rác 
    //- End Section 5

    //- Section 6
    .section-6 
      .table-2 
        table
          thead
            tr
              th(class="inner-center")
                input(type="checkbox" class="inner-check" check-all)
              th Tên tour
              th Ảnh đại diện
              th Giá
              th Còn lại
              th(class="inner-center") Vị trí 
              th(class="inner-center") Trạng thái
              th Tạo bởi
              th Cập nhật bởi
              th.inner-center Hành động 
          tbody
            each item in tourList
              tr
                td(class="inner-center")
                  input(type="checkbox" class="inner-check" check-item=item.id)
                td.inner-col-title #{item.name}
                td 
                  img(src=item.avatar, class="inner-avatar")
                td
                  div.inner-nowrap NL: #{(item.newPriceAdult > 0 ? item.newPriceAdult : item.priceAdult).toLocaleString("vi-VN")}đ
                  div.inner-nowrap TE: #{(item.newPriceChildren > 0 ? item.newPriceChildren : item.priceChildren).toLocaleString("vi-VN")}đ
                  div.inner-nowrap EB: #{(item.newPriceBaby > 0 ? item.newPriceBaby : item.priceBaby).toLocaleString("vi-VN")}đ
                td
                  div.inner-nowrap NL: #{item.stockAdult}
                  div.inner-nowrap TE: #{item.stockChildren}
                  div.inner-nowrap EB: #{item.stockBaby}
                td(class="inner-center") #{item.position}
                td(class="inner-center")
                  if(item.status == "active")
                    .badge.badge-green Hoạt động
                  else if(item.status == "inactive")
                    .badge.badge-red Tạm dừng
                  else if(item.status == "deleted")
                    .badge.badge-orange Xóa
                td 
                  div.inner-nowrap #{item.createdByFullName}
                  div.inner-time.inner-nowrap #{item.createdAtFormatted}
                td 
                  div.inner-nowrap #{item.updatedByFullName}
                  div.inner-time.inner-nowrap #{item.updatedAtFormatted}
                td.inner-center
                  .inner-buttons
                    if(account.permissions.includes("tour-edit"))
                      a(
                        class="inner-edit"
                        href=`/${pathAdmin}/tour/edit/${item.id}`
                        ) <i class="fa-regular fa-pen-to-square"></i> 
                    if(account.permissions.includes("tour-delete"))
                      button(
                        class="inner-delete"
                        button-delete
                        data-api=`/${pathAdmin}/tour/delete/${item.id}`
                      ) <i class="fa-regular fa-trash-can"></i>
    //- End Section 6

    //- Section 7
    +pagination(pagination, tourList.length)
    //- End Section 7