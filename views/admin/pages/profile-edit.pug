extends ../layouts/layout-default.pug

block main
  h1.box-title Thông tin cá nhân 

  //- Section 8
  .section-8  
    form#profile-edit-form
      .inner-group
        label(for="fullName" class="inner-label") Họ tên 
        input(type="text" id="fullName" name="fullName" value=profileDetail.fullName)
      .inner-group
        label(for="email" class="inner-label") Email 
        input(type="text" id="email" name="email" value=profileDetail.email)
      .inner-group
        label(for="phoneNumber" class="inner-label") Số điện thoại
        input(type="number" id="phoneNumber" name="phoneNumber" value=profileDetail.phoneNumber)
      .inner-group
        label(for="position" class="inner-label") Chức vụ 
        input(type="text" id="position" name="position" value=profileDetail.positionCompany readonly)
      .inner-group
        label(for="role" class="inner-label") Nhóm quyền 
        input(type="text" id="role" name="role" value=profileDetail.roleName readonly) 
      .inner-group.inner-two-col
        label(for="avatar" class="inner-label") Ảnh đại diện
        div(class="inner-upload-image" image-default=profileDetail.avatar)
          input(type="file" id="avatar" name="avatar" accept="image/*" filepond-image ) 
      .inner-button.inner-two-col
        button Cập nhật
    .inner-back
      a(href=`/${pathAdmin}/profile/change-password`) Đổi mật khẩu 
  //- End Section 8