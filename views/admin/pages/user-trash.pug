extends ../layouts/layout-default.pug
include ../mixins/pagination.pug
include ../mixins/bulk-action.pug

block main
  h1.box-title Thùng rác người dùng

  //- Section 5
  .section-5 
    .inner-wrap
      .inner-search
        <i class="fa-solid fa-magnifying-glass"></i>
        input(type="text" placeholder="Tìm kiếm theo tên, email, sđt..." search)  
      .inner-button-create
        a(href=`/${pathAdmin}/user/list` style="background-color: #6C757D;") <i class="fa-solid fa-arrow-left"></i> Quay lại danh sách
  //- End Section 5

  +bulkAction(`/${pathAdmin}/user/trash/change-multi`, [
    { value: "undo", label: "Khôi phục" },
    { value: "delete-permanent", label: "Xóa vĩnh viễn" }
  ])

  //- Section 6
  .section-6 
    .table-2 
      table
        thead
          tr
            th(class="inner-center")
            th Họ tên
            th(class="inner-center") Ảnh đại diện
            th Email 
            th(class="inner-center") Số điện thoại
            th Địa chỉ
            th(class="inner-center inner-sortable" title="Nhấp để đổi thứ tự sắp xếp")
              .inner-sort-wrap
                span Thời gian xóa
                button(
                  type="button"
                  class=`button-sort ${(sortKey == 'deletedAt' ? 'active' : '')}`
                  button-sort="deletedAt"
                  data-value=(sortKey == 'deletedAt' ? sortValue : 'desc')
                )
                  if (sortKey == 'deletedAt' && sortValue == 'asc')
                    <i class="fa-solid fa-arrow-up-wide-short"></i>
                  else if (sortKey == 'deletedAt' && sortValue == 'desc')
                    <i class="fa-solid fa-arrow-down-wide-short"></i>
                  else
                    <i class="fa-solid fa-sort"></i>
            th.inner-center Hành động 
        tbody
          if(userList && userList.length > 0)
            each item in userList
              tr
                td(class="inner-center")
                  input(type="checkbox" class="inner-check" check-item=item._id)
                td.inner-col-name #{item.fullName}
                td.inner-center
                  img(src=(item.avatar || "/admin/assets/images/batman.png"), class="inner-avatar")
                td.inner-col-email #{item.email}
                td(class="inner-center inner-nowrap") #{item.phone || "---"}
                td.inner-col-address #{item.address || "---"}
                td(class="inner-center inner-nowrap") #{item.deletedAtFormatted}
                td.inner-center
                  .inner-buttons
                    button(
                      class="inner-undo"
                      button-undo
                      data-api=`/${pathAdmin}/user/undo/${item._id}`
                      title="Khôi phục người dùng"
                    ) <i class="fa-solid fa-arrow-rotate-left"></i>
                    button(
                      class="inner-delete"
                      button-delete
                      data-api=`/${pathAdmin}/user/destroy/${item._id}`
                      title="Xóa vĩnh viễn"
                    ) <i class="fa-regular fa-trash-can"></i>
          else
            tr
              td(colspan="8" class="inner-center") Thùng rác trống
  //- End Section 6

  //- Section 7
  +pagination(pagination, userList ? userList.length : 0)
  //- End Section 7

  script(src="/admin/assets/js/user.js")
