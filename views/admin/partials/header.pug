header.header
  .inner-logo
    a(href=`/${pathAdmin}/dashboard`)
      i.fa-solid.fa-plane-departure(aria-hidden="true")
      span Tour Admin
  .inner-wrap
    .inner-account
      .inner-avatar
        img(src=account.avatar, alt="avatar")
      .inner-text
        .inner-name #{account.fullName}
        .inner-role #{account.roleName}
    button.inner-button-menu(type="button" aria-label="Mở menu")
      <i class="fa-solid fa-bars"></i>
