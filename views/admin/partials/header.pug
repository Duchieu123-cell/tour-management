header.header 
  .inner-logo 
    a(href=`/${pathAdmin}/dashboard`)
        span Bat
        span man 
  .inner-wrap
    .inner-notify
        img(src="/admin/assets/images/icon-bell.svg", alt="icon-bell")
        span 6
    .inner-account
      .inner-avatar
        img(src=account.avatar, alt="avatar")
      .inner-text
        .inner-name #{account.fullName}
        .inner-role #{account.roleName}
    button.inner-button-menu
      <i class="fa-solid fa-bars"></i>